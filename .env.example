# Copy to .env and fill in. Never commit .env.
# Prefer exporting the key in your shell instead (see participant_instructions.md).
LLM_PROVIDER=btelligent
BTELLIGENT_API_KEY=
# alternatives:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# optional overrides:
# REWRITER_MODEL=gpt-6-luna
# LLM_CACHE_DIR=.llm_cache
